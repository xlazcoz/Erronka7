# ---------------------------------------------------------------------------
# Powerbank · ingurune-aldagaiak
# Kopiatu fitxategi hau `.env` gisa eta bete balioak:
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# PostgreSQL konexioa (tokiko garapenerako; produkzioan Dockerrek berak eraikitzen du)
DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/alokairu_sistema

# Saio-cookiea HTTPS bidez bakarrik bidaltzea. Produkzioan TRUE.
COOKIE_SECURE=false

# Swagger/OpenAPI dokumentazioa. Produkzioan false gomendatzen da.
DOCS_ENABLED=true

# CORS: produkzioan jatorri zehatzak jarri komaz banatuta.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4200,http://127.0.0.1:4200
# CORS_ORIGIN_REGEX=

# Saio-hasieraren aurkako babesa
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
# Saioaren iraupena segundotan (7 egun)
SESSION_MAX_AGE_SECONDS=604800

# Irudien igoera (bytes)
MAX_IMAGE_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# docker-compose erabiltzeko soilik
# ---------------------------------------------------------------------------
POSTGRES_DB=alokairu_sistema
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
